interface int0
 ip mtu 1500
 connect port te0 service-instance int0
 ip nat outside
 ip address 172.16.1.2/28
!
interface hq.100
 description to hq.100
 ip mtu 1500
 connect port te1 service-instance hq.100
 ip nat inside
 ip address 172.16.10.1/28
!
interface hq.200
